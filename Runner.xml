<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Suite" parallel="tests" thread-count="2">

    <listeners>
        <listener class-name="RetryListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="Login">
        <classes>
            <class name="LoginTest"/>
            <class name="DashBoardTest"/>
        </classes>
    </test>

    <test name="PIM">
        <classes>
            <class name="PIMTest"/>
            <class name="AddEmployeeTest"/>
        </classes>
    </test>

    <test name="Admin">
        <classes>
            <class name="AdminTest"/>
        </classes>
    </test>

</suite>